# ============================================================
#  Pro AI Agent OS — Environment Configuration
# ============================================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env   (Linux/Mac)
#    copy .env.example .env (Windows)
# ============================================================

# === REQUIRED ===================================================
# PostgreSQL connection string (Neon, Supabase, local, etc.)
# Your database MUST have the pgvector extension enabled.
# Run this SQL in your database: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key (for embeddings & AI features)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL (features work without these) =====================

# Telegram Bot notifications
# Create a bot via @BotFather on Telegram, then get your Chat ID
TELEGRAM_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id

# Notion integration (optional — syncs NEW tasks to a Notion database on create)
# Create an integration at: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Groq API (optional — used by morning_brief.py for AI summaries)
# Without this, morning_brief.py still works with a plain text summary
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Your name (used in morning brief messages and Telegram greetings)
USER_NAME=YourName
